# ── CMS Ruang Kendali (Patch 4, 22 Sep 2026) ──
# Postgres Neon (Vercel Marketplace → Storage → Neon; salin "DATABASE_URL" pooled). Tanpa ini: /admin mode baca.
DATABASE_URL=
# Uji lokal tanpa Neon (dev saja, Postgres WASM via @electric-sql/pglite): direktori data, mis. .cache/pgdata
# CMS_DB_LOKAL=
# Kata sandi bersama per peran (bagikan lewat kanal internal Tim Koordinasi; ganti berkala).
CMS_SANDI_KOORDINATOR=
CMS_SANDI_PJ=
# Rahasia HMAC sesi (≥ 32 karakter acak): `openssl rand -base64 48`
CMS_SESI_RAHASIA=
